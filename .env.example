# Copy to .env.local and fill real values. Never commit .env.local.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_ADMIN_EMAILS=admin@example.com
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_R2_PUBLIC_BASE_URL=

# Scraper de notícias (GitHub Actions) — auto|on|off (fallback LLM ScrapeGraphAI)
USE_SGAI=auto
# Base URL pública R2 usada pelas Edge Functions (server-side, sem prefixo VITE_)
R2_PUBLIC_BASE_URL=

# Observability (optional — Sentry stays disabled if empty)
VITE_SENTRY_DSN=

# Server-side only (Edge Functions / local scripts)
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=

# Deploy (optional — Vercel CLI/OIDC em CI, só se aplicável)
VERCEL_OIDC_TOKEN=
